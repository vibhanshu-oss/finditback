# Root-level .gitignore — covers both backend and frontend
# ─────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.*.local
.env.production

# Build output
dist/
dist-ssr/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing / coverage
coverage/
.nyc_output/

# Misc
*.local
*.tgz

# Scratch and Agent Cache
scratch/
.gemini/
.agents/

