PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/finditback?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=your_super_secure_random_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Email SMTP configurations (Optional - for Password Reset OTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_user_key_here
EMAIL_PASS=your_smtp_password_key_here
EMAIL_FROM=FindItBack <noreply@finditback.com>
